<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RusK.props" />

  <PropertyGroup>
    <AssemblyName>RuskUi</AssemblyName>
    <RootNamespace>RusK.Mods.Ui</RootNamespace>
    <Version>1.1.1</Version>
    <DeployDir>$(RuskGameDir)\mods</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <!-- スキルゲージの Image.fillAmount を読むため -->
    <Reference Include="$(InteropDir)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.UIModule.dll" Private="false" />
    <!-- キラーン音の再生 -->
    <Reference Include="$(InteropDir)\UnityEngine.AudioModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RusK.Mods.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RusK.API\RusK.API.csproj" Private="false" />
  </ItemGroup>
</Project>
