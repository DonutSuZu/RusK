<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RusK.props" />

  <PropertyGroup>
    <AssemblyName>RuskParty</AssemblyName>
    <RootNamespace>RusK.Mods.Party</RootNamespace>
    <Version>1.4.0</Version>
    <DeployDir>$(RuskGameDir)\mods</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <!-- 敵の AI (Behavior Designer) の変数を付け替える -->
    <Reference Include="$(InteropDir)\BehaviorDesigner.Runtime.dll" Private="false" />
    <!-- Party Lab: フィールドに置いたキャラのアニメ (Animancer) を調べる -->
    <Reference Include="$(InteropDir)\Animancer.dll" Private="false" />
    <!-- Animator -->
    <Reference Include="$(InteropDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <!-- Party Lab: 置くときに地面の高さに合わせる (Raycast) -->
    <Reference Include="$(InteropDir)\UnityEngine.PhysicsModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RusK.Mods.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RusK.API\RusK.API.csproj" Private="false" />
  </ItemGroup>
</Project>
