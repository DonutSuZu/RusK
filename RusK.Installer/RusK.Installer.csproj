<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RusK のセットアップウィザード。
    .NET Framework 4.8 (Windows 10/11 に標準で入っている) の WinForms アプリなので、利用者は追加インストール不要。
    ビルド時に RusK 本体を payload.zip にまとめて exe に埋め込む。Mod はインストール時に GitHub のリリースからダウンロードする。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>RusK-Setup</AssemblyName>
    <RootNamespace>RusK.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- icon.ico は ..\icon.png から作ったもの (16～256px) -->
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Version>1.1.4</Version>
    <Product>RusK</Product>
    <Company>RusK</Company>
    <Description>RusK Mod Loader Setup</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DistDir>$(MSBuildThisFileDirectory)..\dist\</DistDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- .NET Framework 4.8 の参照アセンブリ (SDK だけでビルドできるように) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- Mod を GitHub のリリースからダウンロードする (HttpClient と、リリース一覧の JSON の読み取り) -->
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- セットアップ画面のロゴ用 -->
    <EmbeddedResource Include="..\icon.png" LogicalName="icon.png" />
  </ItemGroup>

  <!-- 同梱するプロジェクト。先にビルドさせるだけで参照はしない (ゲームへの自動配置もしない) -->
  <ItemGroup>
    <ProjectReference Include="..\RusK.Core\RusK.Core.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
    <ProjectReference Include="..\RusK.Mods.Music\RusK.Mods.Music.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
    <ProjectReference Include="..\RusK.Mods.Extreme\RusK.Mods.Extreme.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
    <ProjectReference Include="..\RusK.Mods.Ui\RusK.Mods.Ui.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
    <ProjectReference Include="..\RusK.Mods.Camera\RusK.Mods.Camera.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
    <ProjectReference Include="..\RusK.Mods.Party\RusK.Mods.Party.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
    <ProjectReference Include="..\RusK.Mods.Model\RusK.Mods.Model.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
    <ProjectReference Include="..\RusK.Mods.ItemModel\RusK.Mods.ItemModel.csproj" ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true" AdditionalProperties="DeployToGame=false" />
  </ItemGroup>

  <!-- 配布物をゲームフォルダと同じ並びで集めて zip にし、exe に埋め込む -->
  <Target Name="BuildPayload" AfterTargets="ResolveProjectReferences" BeforeTargets="PrepareForBuild;PrepareResources">
    <PropertyGroup>
      <!-- IntermediateOutputPath は SDK が後から決めるので、ターゲットの中で組み立てる (obj\Release\ の下) -->
      <_ObjDir>$([System.IO.Path]::Combine($(MSBuildProjectDirectory), $(IntermediateOutputPath)))</_ObjDir>
      <PayloadStaging>$(_ObjDir)payload_staging\</PayloadStaging>
      <PayloadZip>$(_ObjDir)payload.zip</PayloadZip>
      <CoreOut>$(MSBuildThisFileDirectory)..\RusK.Core\bin\$(Configuration)\</CoreOut>
      <MusicOut>$(MSBuildThisFileDirectory)..\RusK.Mods.Music\bin\$(Configuration)\</MusicOut>
      <ExtremeOut>$(MSBuildThisFileDirectory)..\RusK.Mods.Extreme\bin\$(Configuration)\</ExtremeOut>
      <UiOut>$(MSBuildThisFileDirectory)..\RusK.Mods.Ui\bin\$(Configuration)\</UiOut>
      <CameraOut>$(MSBuildThisFileDirectory)..\RusK.Mods.Camera\bin\$(Configuration)\</CameraOut>
      <PartyOut>$(MSBuildThisFileDirectory)..\RusK.Mods.Party\bin\$(Configuration)\</PartyOut>
      <ModelOut>$(MSBuildThisFileDirectory)..\RusK.Mods.Model\bin\$(Configuration)\</ModelOut>
      <ItemModelOut>$(MSBuildThisFileDirectory)..\RusK.Mods.ItemModel\bin\$(Configuration)\</ItemModelOut>
    </PropertyGroup>
    <ItemGroup>
      <_Core Include="$(CoreOut)RusK.Core.dll;$(CoreOut)RusK.Core.pdb;$(CoreOut)RusK.API.dll;$(CoreOut)RusK.API.pdb" />
    </ItemGroup>
    <Error Condition="!Exists('$(CoreOut)RusK.Core.dll')" Text="RusK.Core.dll が見つかりません: $(CoreOut)" />
    <RemoveDir Directories="$(PayloadStaging)" />
    <Copy SourceFiles="@(_Core)" DestinationFolder="$(PayloadStaging)BepInEx\plugins\RusK" Condition="Exists('%(FullPath)')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)Docs\README.txt" DestinationFolder="$(PayloadStaging)RusK" />
    <ZipDirectory SourceDirectory="$(PayloadStaging)" DestinationFile="$(PayloadZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
    </ItemGroup>
  </Target>

  <!-- できた exe を dist フォルダへ -->
  <Target Name="CopyToDist" AfterTargets="Build">
    <MakeDir Directories="$(DistDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(DistDir)RusK-Setup-v$(Version).exe" />
    <Message Importance="high" Text="Installer -&gt; $(DistDir)RusK-Setup-v$(Version).exe" />
  </Target>
</Project>
