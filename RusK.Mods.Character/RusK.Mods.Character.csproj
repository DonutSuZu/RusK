<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RusK.props" />

  <PropertyGroup>
    <AssemblyName>RuskCharacter</AssemblyName>
    <RootNamespace>RusK.Mods.Character</RootNamespace>
    <Version>1.1.0</Version>
    <DeployDir>$(RuskGameDir)\mods</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- キャラの定義 (MotionManager)・セーブ (GameSave)・名前 (GameUtil.GetLocale) -->
    <Reference Include="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <!-- キャラの絵 (PNG の読み書き) -->
    <Reference Include="$(InteropDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <!-- 動作の一覧 (Animancer.ClipTransition のクリップ) -->
    <Reference Include="$(InteropDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\Animancer.dll" Private="false" />
    <!-- キャラを並べる画面のスクロール (GridLayoutGroup・ScrollRect) -->
    <Reference Include="$(InteropDir)\UnityEngine.UI.dll" Private="false" />
    <!-- 資料の書き出し (声の一覧 AudioClip) -->
    <Reference Include="$(InteropDir)\UnityEngine.AudioModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RusK.Mods.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RusK.API\RusK.API.csproj" Private="false" />
  </ItemGroup>
</Project>
