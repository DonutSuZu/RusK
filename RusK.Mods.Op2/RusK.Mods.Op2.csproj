<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RusK.props" />

  <PropertyGroup>
    <!-- RuskParty.dll の後に読み込まれる名前 (読み込み順に頼らない作りだが、念のため) -->
    <AssemblyName>RuskPartyOp2</AssemblyName>
    <RootNamespace>RusK.Mods.Op2</RootNamespace>
    <Version>1.0.1</Version>
    <DeployDir>$(RuskGameDir)\mods</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <!-- キャラを地面に置く (Raycast)・走らせる (CharacterController) -->
    <Reference Include="$(InteropDir)\UnityEngine.PhysicsModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- 水がたまるゲージ (RusK UI のボタン HUD と同じもの) -->
    <Compile Include="..\RusK.Mods.Ui\LiquidFill.cs" Link="Shared\LiquidFill.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RusK.API\RusK.API.csproj" Private="false" />
  </ItemGroup>
</Project>
