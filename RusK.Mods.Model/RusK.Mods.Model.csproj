<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RusK.props" />

  <PropertyGroup>
    <AssemblyName>RuskModel</AssemblyName>
    <RootNamespace>RusK.Mods.Model</RootNamespace>
    <Version>1.4.0</Version>
    <DeployDir>$(RuskGameDir)\mods</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(InteropDir)\Assembly-CSharp.dll" Private="false" />
    <Reference Include="$(InteropDir)\UnityEngine.AnimationModule.dll" Private="false" />
    <Reference Include="$(InteropDir)\Animancer.dll" Private="false" />
    <!-- 見せるためのモデルの更新 (CinemachineBrain.LateUpdate の後) -->
    <Reference Include="$(InteropDir)\Cinemachine.dll" Private="false" />
    <!-- VRM のテクスチャ (png / jpg) の読み込み -->
    <Reference Include="$(InteropDir)\UnityEngine.ImageConversionModule.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\RusK.Mods.Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RusK.API\RusK.API.csproj" Private="false" />
  </ItemGroup>
</Project>
